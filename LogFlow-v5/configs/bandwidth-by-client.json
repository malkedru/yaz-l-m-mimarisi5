{
  "pipeline": {
    "name": "bandwidth-by-client",
    "source": {
      "type": "file",
      "params": {
        "path": "data/access-small.log"
      }
    },
    "stages": [
      {
        "type": "parse",
        "params": {
          "format": "clf"
        }
      },
      {
        "type": "project",
        "params": {
          "fields": [
            "clientIp",
            "bytes"
          ]
        }
      }
    ],
    "sink": {
      "type": "file",
      "params": {
        "path": "out/bandwidth-by-client.tsv"
      }
    }
  }
}
